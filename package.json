{
  "name": "coffeeos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node scripts/test-harness.mjs",
    "test:inventory": "node scripts/test-harness.mjs --inventory",
    "test:harness": "node --test tests/harness.test.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:review": "node tests/review-browser.mjs",
    "test:db": "node tests/db-safari.mjs",
    "test:db:firefox": "node tests/db-browser.mjs",
    "test:safari": "node tests/db-safari.mjs",
    "test:photos": "node tests/photo-browser.mjs",
    "test:offline": "node tests/offline-browser.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:upgrade": "node tests/bean-upgrade.mjs",
    "test:upgrade:firefox": "TEST_FIREFOX=1 node tests/bean-upgrade.mjs",
    "test:backups": "node tests/backups-browser.mjs",
    "test:drive": "node tests/drive-auth-helper.mjs && node tests/drive-browser.mjs",
    "test:drive:authorization": "node tests/drive-authorization.mjs",
    "test:drive:diagnostics": "node tests/drive-diagnostics.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@jsquash/webp": "^1.5.0",
    "fflate": "0.8.3"
  }
}
